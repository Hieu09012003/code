def read_license_plate_from_file(file_path: str) -> LPResult:
    """
    Hàm bao bọc để đọc ảnh, khởi tạo Reader và gọi hàm read.
    """
    try:
        # Tải ảnh bằng OpenCV
        image = cv2.imread(file_path)
        if image is None:
            return LPResult(None, "FAIL: Cannot read image", None)
            
        # Khởi tạo Reader (để tải models nếu chưa có)
        reader = Reader()
        
        # Gọi hàm read chính
        result = Reader.read(image, plot=False, fname=os.path.basename(file_path))
        return result
        
    except Exception as e:
        return LPResult(None, f"FAIL: {e}", None)
