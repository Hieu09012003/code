# 🚨 THAY THẾ ĐỊA CHỈ IP VÀ PORT CỦA RASPBERRY PI CỦA BẠN
PI_IP_ADDRESS = "192.168.137.61" # Ví dụ: Thay bằng IP thực tế của Pi
PORT = 8000
STREAM_URL = f"http://{PI_IP_ADDRESS}:{PORT}/stream.mjpg" 

VIOLATION_DIR = "captured_plates_always_red"
PLATE_EXPANSION_FACTOR = 0.7           
SUMMARY_OUTPUT_PATH = "./violation_summary_always_red.csv"

# Kích thước khung hình mặc định của Stream (phải khớp với Pi server)
CAMERA_WIDTH = 640
CAMERA_HEIGHT = 480

